@startuml
title BrokerX - Bounded Contexts

package "Order Context" {
  [Order]
  [ComplianceRules]
}

package "Market Data Context" {
  [Instrument]
}

package "User Context" {
  [User]
}

package "Portfolio Context" {
  [Executions]
  [Positions]
  [Wallet]
}

package "Matching Context" {
  [OrderBook]
}

package "Notification Context" {
  [NotificationPreferences]
  [UserContactInfo]
}

' Relationships
[Order] --> [Executions] : produces
[Order] --> [OrderBook] : listed in

[Order] --> [Instrument] : references
[User] --> [Positions] : holds

[User] --> [Wallet] : adds funds to
[User] --> [Order] : manages

[ComplianceRules] --> [Order] : validate

[User] --> [NotificationPreferences] : sets
[User] --> [UserContactInfo] : provides

@enduml

