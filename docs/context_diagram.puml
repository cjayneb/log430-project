@startuml
!define RECTANGLE class

title BrokerX - System Scope (Context Diagram)

actor Client as C
actor "Back-Office / Operations" as BO
actor "Compliance / Risk" as CR
actor "Payment Gateway / Bank" as PG
actor "Market Data Provider" as MDP

rectangle "BrokerX System" as BX {
  rectangle "Authentication" as Auth
  rectangle "Order Placement" as Order
  rectangle "Market Data Subscription" as MarketData
  rectangle "Matching & Execution" as Matching
}

C --> Auth : Login / Registration
C --> Order : Place / Modify / Cancel Orders
C --> MarketData : Subscribe / View Quotes

Order --> Matching : Orders for execution
Matching --> Order : Execution reports

BX --> MDP : Request market data
MDP --> BX : Price updates, instruments

BX --> BO : Trade reports, settlements
BX --> CR : Audit logs, risk monitoring
BX --> PG : Wallet funding requests
PG --> BX : Payment confirmations

@enduml
